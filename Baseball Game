import java.util.Stack;

class Solution {
    public int calPoints(String[] operations) {
        Stack<Integer> scoreStack = new Stack<>();
        for (String op : operations) {
            switch (op) {
                case "C":
                    scoreStack.pop();
                    break;
                    
                case "D":
                    scoreStack.push(2 * scoreStack.peek());
                    break;
                    
                case "+":
                    int top1 = scoreStack.pop();
                    int top2 = scoreStack.peek();
                    int sum = top1 + top2;
                    scoreStack.push(top1);
                    scoreStack.push(sum);
                    break;
                    
                default:
                    scoreStack.push(Integer.parseInt(op));
                    break;
            }
        }
        int totalSum = 0;
        for (int score : scoreStack) {
            totalSum += score;
        }
        
        return totalSum;
    }
}
