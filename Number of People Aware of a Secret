class Solution {
    public int peopleAwareOfSecret(int n, int delay, int forget) {
        long MOD = 1_000_000_007;
        long[] dp = new long[n + 1];
        dp[1] = 1;
        long sharing = 0;
        for(int i = 2; i <= n; i++){
            long newSharers = (i - delay >= 1) ? dp[i - delay] : 0;
            long forgottenSharers = (i - forget >= 1) ? dp[i - forget] : 0;
            sharing = (sharing + newSharers - forgottenSharers + MOD) % MOD;
            dp[i] = sharing;
        }
        long activeKnowers = 0;
        for (int i = Math.max(1, n - forget + 1); i <= n; i++) {
            activeKnowers = (activeKnowers + dp[i]) % MOD;
        }
        return (int) activeKnowers;
        
    }
}
